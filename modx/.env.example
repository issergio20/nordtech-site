# Секреты сайта НОРД. MODX не читает .env сам: значения задаются в пуле PHP-FPM сайта
# (/etc/php/8.2/fpm/pool.d/nordtech.conf → env[NORD_TG_BOT_TOKEN] = ...) и в окружении cron.
# Значения заводит и вписывает владелец аккаунтов (клиент или ВостокВеб), не Claude. Файл с реальными значениями в git не кладём.

# Telegram: бот создаётся в @BotFather, добавляется в чаты филиалов; chat_id чатов — в таблице филиалов (tg_chat_id)
NORD_TG_BOT_TOKEN=
# Чат, куда идут заявки без филиала или если у филиала нет своего чата
NORD_TG_DEFAULT_CHAT_ID=

# Yandex SmartCaptcha (Yandex Cloud → SmartCaptcha): серверный ключ. Клиентский ключ — в шаблоне: window.NORD_CAPTCHA_SITEKEY
NORD_SMARTCAPTCHA_SERVER_KEY=

# Копия всех заявок (например, руководителю). Необязательно.
NORD_LEADS_CC_EMAIL=
# Адрес отправителя писем — ящик на домене nordtech.su с SPF/DKIM/DMARC
NORD_MAIL_FROM=

# Срок хранения заявок в годах (по умолчанию 3, согласовать с клиентом и вписать в политику)
NORD_LEADS_RETENTION_YEARS=3

# SMTP настраивается в системных настройках MODX (mail_use_smtp, mail_smtp_hosts, mail_smtp_user, mail_smtp_pass, mail_smtp_port=465, mail_smtp_prefix=ssl)
# Бэкап — отдельный файл /etc/nord-backup.env: DB_NAME, DB_USER, DB_PASS, SITE_DIR, BACKUP_DIR, S3_BUCKET, S3_ENDPOINT
