---
layout: layouts/base.njk
title: Лизинг спецтехники
permalink: /uslug/servisnye-uslugi/lizing/
description: Лизинг спецтехники в НОРД — аванс от 10%, срок от 12 до 60 месяцев, предварительное решение в течение 2 часов, документы в банк подаём сами.
---
{% import "ui.njk" as ui with context %}
{# Текст — с nordtech.su (импорт в src/_includes/original/lizing.njk), подача — «НОРД Тёмный» #}
<header class="page-head page-head--image">
  <img class="page-head__bg" src="/assets/template/img/escort/img-1.webp" alt="" width="1600" height="900" fetchpriority="high">
  <div class="wrap">
    {{ ui.crumbs([{title: "Услуги", url: "/uslug/"}, {title: "Сервисные услуги", url: "/uslug/servisnye-uslugi/"}], "Спецтехника лизинг") }}
    <h1 class="page-head__title">Спецтехника в лизинг</h1>
    <p class="page-head__lead">Вы выбираете технику и подаёте заявку, мы даём предварительное решение в течение 2 часов. Документы в банк подаём сами — вы приходите на подписание и оплату.</p>
    <div class="btn-row">{{ ui.btn("Заявка на лизинг", lead="leasing") }}{{ ui.btn("Смотреть условия", href="#conditions", kind="secondary", ico="arrow-down") }}</div>
    <ul class="hero__bar" style="margin-top:clamp(40px,5vw,80px)">
      <li class="hero__fact"><b>от 10%</b><span>авансовый платёж</span></li>
      <li class="hero__fact"><b>12–60 мес</b><span>срок лизинга</span></li>
      <li class="hero__fact"><b>от 6%</b><span>годовых</span></li>
      <li class="hero__fact"><b>2 часа</b><span>Предварительное решение — в течение 2 часов</span></li>
    </ul>
  </div>
</header>

<section class="section" id="conditions" aria-labelledby="cond-title">
  <div class="wrap">
    {{ ui.secHead("Условия", "Основные условия лизинга", "", "", "", "cond-title") }}
    <div class="f-grid">
      {{ ui.fCard("calendar", "Срок лизинга", "От 12 до 60 месяцев. Срок договора зависит от типа спецтехники и индивидуальных потребностей клиента.") }}
      {{ ui.fCard("cash", "Авансовый платёж", "От 10% до 30% от стоимости техники. Точный размер определяется по финансовому состоянию клиента и типу спецтехники.") }}
      {{ ui.fCard("sliders", "Ежемесячные платежи", "Фиксированные или аннуитетные. Гибкий график, который можно адаптировать под финансовые возможности клиента.") }}
      {{ ui.fCard("percent", "Процентная ставка", "От 6% до 12% годовых. Ставка зависит от срока лизинга, типа спецтехники и кредитного рейтинга клиента.") }}
      {{ ui.fCard("coins", "Валюта договора", "Рубли или иностранная валюта — выбор валюты снижает риски, связанные с колебаниями курсов.") }}
      {{ ui.fCard("tag", "Выкупная стоимость", "По окончании срока технику можно выкупить по остаточной стоимости, которая оговаривается в договоре.") }}
    </div>
  </div>
</section>

<section class="section section--raised" aria-labelledby="adv-title">
  <div class="wrap">
    {{ ui.secHead("Почему у нас", "Преимущества лизинга у нас", "", "", "", "adv-title") }}
    <div class="f-grid">
      {{ ui.fCard("sliders", "Гибкие условия лизинга", "Подбираем индивидуальные условия для каждого клиента в зависимости от его потребностей.") }}
      {{ ui.fCard("cash", "Минимальные авансовые платежи", "Доступный порог входа позволяет получить спецтехнику без значительных начальных затрат.") }}
      {{ ui.fCard("calendar", "Оптимальный график платежей", "Удобный график платежей, включая сезонные и аннуитетные.") }}
      {{ ui.fCard("receipt", "Налоговые преимущества", "Лизинговые платежи можно учесть в затратах, что уменьшает налогооблагаемую базу.") }}
      {{ ui.fCard("layers", "Обновление парка техники", "Регулярно обновляйте спецтехнику без больших единовременных вложений.") }}
      {{ ui.fCard("wrench", "Поддержка и обслуживание", "В договор можно включить техническое обслуживание и ремонт техники.") }}
    </div>
  </div>
</section>

<section class="section section--raised" aria-labelledby="docs-title">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="eyebrow">Документы</p><h2 class="sec-head__title" id="docs-title">Документы для оформления лизинга</h2></div>
      {{ ui.btn("Оформить лизинг", lead="leasing", kind="secondary") }}
    </header>
    <ol class="doc-list">
      <li data-reveal-item>Заявка на лизинг (образец предоставляет менеджер)</li>
      <li data-reveal-item>Учредительные документы компании (копии)</li>
      <li data-reveal-item>Финансовая отчётность за последние 2 года (баланс и отчёт о прибылях и убытках)</li>
      <li data-reveal-item>Паспорт и ИНН руководителя компании</li>
      <li data-reveal-item>Договоры с клиентами, подтверждающие доходы компании (при наличии)</li>
      <li data-reveal-item>Любые дополнительные документы по запросу лизинговой компании</li>
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="proc-title">
  <div class="wrap">
    {{ ui.secHead("Процесс", "Процесс оформления лизинга", "", "", "", "proc-title") }}
    <ol class="steps">
      {{ ui.step(1, "message", "Предварительная консультация", "Обратитесь к менеджеру за консультацией и предварительным расчётом условий лизинга") }}
      {{ ui.step(2, "file", "Подача заявки", "Заполните и отправьте заявку на лизинг вместе с необходимыми документами") }}
      {{ ui.step(3, "clock", "Рассмотрение заявки", "Лизинговая компания рассматривает документы 3–5 рабочих дней, мы ведём процесс за вас") }}
      {{ ui.step(4, "check", "Заключение договора", "После одобрения подписывается договор лизинга и вносится авансовый платёж") }}
      {{ ui.step(5, "truck", "Поставка техники", "Спецтехника поставляется клиенту в согласованные сроки") }}
      {{ ui.step(6, "wrench", "Техническая поддержка", "Весь срок лизинга — техническая поддержка и обслуживание техники") }}
    </ol>
  </div>
</section>

<section class="section section--raised" aria-labelledby="partners-title">
  <div class="wrap">
    {{ ui.secHead("Лизинговые компании", "Работаем с ведущими лизинговыми компаниями", "", "", "", "partners-title") }}
    {{ ui.partners() }}
  </div>
</section>
