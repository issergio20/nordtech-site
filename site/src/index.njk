---
layout: layouts/base.njk
title: Главная
isHome: true
permalink: /
---
{% import "ui/ui.njk" as ui %}
{# S01 — главная в разметке оригинала. Исправлено: видимый H1, «Топ-10» без дублей слайдов, сроки лизинга без противоречия, опечатки #}
<section class="about section" id="about">
  <div class="container">
    <div class="about__inner">
      <h1 class="about__title section__title section__title--white">Надежная спецтехника для больших задач</h1>
      <p class="about__text">Мы — гарант работы вашего бизнеса</p>
      <p class="about__subtitle">Для эксплуатации в суровых условиях</p>
    </div>
    <div class="about__btns">
      <button class="about__btn modal-btn" type="button" data-lead="consultation" aria-haspopup="dialog">Получить консультацию</button>
      <a class="about__link" href="/katalog/">Перейти в каталог</a>
    </div>
  </div>
  <svg class="section-icon" aria-hidden="true"><use href="/assets/template/img/sprites/sprite.svg#nord"></use></svg>
  <video class="about__video" src="/assets/template/img/general/video.mp4" autoplay muted loop playsinline preload="none" poster="/assets/template/img/general/about.webp" aria-hidden="true" data-hero-video></video>
  <a class="about__next" href="#why-we" aria-label="К следующему разделу">{{ ui.icon("move-down", 32, 32) }}</a>
</section>

<section class="why-we section" id="why-we">
  <div class="container">
    <h2 class="section__title section__title--indent">Почему мы</h2>
    <div class="why-we__blocks">
      <div class="why-we__block"><p class="why-we__block-title">2019 год</p><p class="why-we__block-text">Являемся официальным дилером спецтехники SHANMON</p></div>
      <div class="why-we__block"><p class="why-we__block-title">1 500 м2</p><p class="why-we__block-text">Общая площадь ангаров со спецтехникой и комплектующими</p></div>
      <div class="why-we__block"><p class="why-we__block-title">120 мин</p><p class="why-we__block-text">Предварительное решение по вашей заявке на лизинг — в течение 2 часов</p></div>
    </div>
    <div class="why-we__slider swiper" data-swiper="why-we">
      <div class="swiper-wrapper">
        {% for i in [1,2,3,4] %}<div class="why-we__slide swiper-slide"><img src="/assets/template/img/why-we/img-{{ i }}.jpg" alt="" width="400" height="460" loading="lazy"></div>{% endfor %}
      </div>
    </div>
    {{ ui.navigations("why-we", "фотографии площадок") }}
  </div>
</section>

<section class="catalog section" id="catalog">
  <div class="container">
    <h2 class="section__title section__title--indent">Каталог</h2>
    <div class="catalog__slider swiper" data-swiper="catalog">
      <div class="catalog__slider-wrapper swiper-wrapper">
        {% for root in catalog.roots %}{% if root.count or not site.hideEmptyCategories %}{{ ui.catalogSlide(root) }}{% endif %}{% endfor %}
      </div>
      {{ ui.navigations("catalog", "разделы каталога") }}
    </div>
  </div>
</section>

<section class="special-equipment section" id="special-equipment">
  <div class="container">
    <h2 class="section__title special-equipment__title">Топ-10 видов спецтехники</h2>
    <p class="special-equipment__text">которую чаще всего покупают наши клиенты</p>
    <div class="special-equipment__slider swiper" data-swiper="special-equipment" role="region" aria-roledescription="карусель" aria-label="Популярные модели">
      <div class="swiper-wrapper">
        {% for p in catalog.popular %}{{ ui.productCard(p) }}{% endfor %}
      </div>
    </div>
    {{ ui.navigations("special-equipment", "популярные модели") }}
  </div>
</section>

<section class="stages-work section" id="stages-work">
  <div class="container">
    <h2 class="section__title section__title--indent">Как мы работаем</h2>
    <ul class="stages-work__list">
      <li class="stages-work__item">{{ ui.icon("square-mouse-pointer", 72, 72) }}<div class="stages-work__item-content"><h3 class="stages-work__item-title">Получаем заявку</h3><p class="stages-work__item-description">Вы оставляете заявку любым удобным способом на сайте, либо в мессенджерах</p></div></li>
      <li class="stages-work__item">{{ ui.icon("tractor", 72, 72) }}<div class="stages-work__item-content"><h3 class="stages-work__item-title">Подбор спецтехники</h3><p class="stages-work__item-description">Наш специалист подберет спецтехнику под вашу задачу с учетом всех требований</p></div></li>
      <li class="stages-work__item">{{ ui.icon("receipt-text", 72, 72) }}<div class="stages-work__item-content"><h3 class="stages-work__item-title">Заключение договора</h3><p class="stages-work__item-description">После согласования выбранной спецтехники мы заключаем с вами договор, где прописаны все гарантии с нашей стороны</p></div></li>
      <li class="stages-work__item">{{ ui.icon("truck-electric", 72, 72) }}<div class="stages-work__item-content"><h3 class="stages-work__item-title">Доставка на объект</h3><p class="stages-work__item-description">Подберем оптимальный вариант доставки, техника будет на объекте в оговоренные сроки</p></div></li>
    </ul>
  </div>
</section>

<section class="escort section" id="escort">
  <div class="container">
    <div class="escort__header">
      <h2 class="section__title escort__title"><a href="/uslug/servisnye-uslugi/">Сервисные услуги</a></h2>
      {{ ui.leasingLink("подробнее", "", "/uslug/servisnye-uslugi/") }}
    </div>
    <div class="escort__slider swiper" data-swiper="escort">
      <div class="swiper-wrapper">
        {% include "partials/escort-slides.njk" %}
      </div>
    </div>
    <div class="escort__block">
      {{ ui.navigations("escort", "сервисные услуги") }}
    </div>
  </div>
</section>

<section class="leasing section" id="leasing">
  <div class="container">
    <header class="leasing__header">
      <h2 class="section__title leasing__title">Спецтехника в лизинг</h2>
      <p class="leasing__text">Мы подготовили самые выгодные условия</p>
      {{ ui.leasingLink("заявка на лизинг", 'data-lead="leasing" aria-haspopup="dialog"') }}
    </header>
    <div class="leasing__body">
      <ul class="leasing__stages">
        <li class="leasing__stage">Вы выбираете технику и подаете заявку</li>
        <li class="leasing__stage">Мы дадим предварительное решение в течение 2 часов.</li>
        <li class="leasing__stage">Документы в банк мы подаём сами.</li>
        <li class="leasing__stage">Вы приходите на подписание и оплату.</li>
      </ul>
      <a class="leasing__body-link" href="/uslug/servisnye-uslugi/lizing/">Смотреть условия {{ ui.arrow() }}</a>
    </div>
  </div>
  <svg class="section-icon" aria-hidden="true"><use href="/assets/template/img/sprites/sprite.svg#nord"></use></svg>
</section>

<section class="partners section block block--indent" id="partners">
  <div class="container">
    <header class="partners__header">
      <h2 class="section__title">Партнеры</h2>
      <p class="partners__text">Наша компания сотрудничает с ведущими поставщиками и лизинговыми компаниями на рынке России</p>
    </header>
    <div class="partners__slider swiper" data-swiper="partners">
      <div class="swiper-wrapper">
        {% for p in [["reco","РЕСО-Лизинг"],["carcade","Каркаде"],["alfalizing","Альфа-Лизинг"],["gasprom","Газпромбанк Автолизинг"]] %}
        <div class="partners__slide swiper-slide"><svg role="img" aria-label="{{ p[1] }}"><use href="/assets/template/img/sprites/sprite.svg#{{ p[0] }}"></use></svg></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
