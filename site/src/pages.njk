---
# Страницы без аналога на текущем сайте (там пусто или нет страницы) — на блоках оригинала: .service-header + .block
layout: layouts/base.njk
pagination:
  data: stubs
  size: 1
  alias: s
permalink: "{{ s.url }}"
eleventyComputed:
  title: "{{ s.title }}"
---
{% import "ui/ui.njk" as ui %}
<section class="leasing-service section">
  <div class="container-secondary">
    {{ ui.serviceHeader(s.title, s.lead, s.crumbs, s.cta, s.ctaLead or "consultation") }}
    <div class="policy__content block block--indent">
      {% for para in s.body %}<p>{{ para }}</p>{% endfor %}
    </div>
  </div>
</section>
