{% import "ui/ui.njk" as ui %}
{# S12 — на текущем сайте ссылка уводит на /##. Блоки оригинала: шапка услуги + этапы как в «Процесс оформления лизинга» #}
<section class="leasing-service section">
  <div class="container-secondary">
    {{ ui.serviceHeader("Логистика", "Привозим технику с наших площадок или напрямую от производителя", [], "Рассчитать доставку") }}
    <div class="leasing-registration-process block block--indent">
      <h2 class="section-title">Как привозим</h2>
      <div class="leasing-registration-process__list">
        {% for st in [["Со склада","техника в наличии отгружается с площадки в Чите, Иркутске или Магадане"],["Из Китая","модели под заказ везём от производителя; в Маньчжурии работает наш представитель [маршрут и сроки уточнить у клиента]"],["До объекта","автомобильным транспортом [способы перевозки уточнить у клиента]"]] %}
        <div class="leasing-registration-process__item">
          <span class="leasing-registration-process__item-counter">{{ loop.index }}.</span>
          <div class="leasing-registration-process__item-content">
            <h3 class="leasing-registration-process__item-title">{{ st[0] }}</h3>
            <p class="leasing-registration-process__item-text">{{ st[1] }}</p>
          </div>
          <img class="leasing-registration-process__item-img" src="/assets/template/img/general/leasing-registration-process.webp" alt="">
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
