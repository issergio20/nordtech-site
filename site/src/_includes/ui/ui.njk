{# UI kit НОРД: макросы в разметке оригинала (BEM-классы из nord.min.css). 1 макрос = 1 будущий чанк Fenom #}
{% set S = "/assets/template/img/sprites/sprite.svg" %}

{% macro icon(id, w=20, h=20) %}<svg width="{{ w }}" height="{{ h }}" aria-hidden="true"><use href="/assets/template/img/sprites/sprite.svg#{{ id }}"></use></svg>{% endmacro %}

{% macro arrow() %}<span class="arrow">{{ icon("arrow-right") }}</span>{% endmacro %}

{% macro breadcrumbs(items, current, currentUrl) %}
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <ul class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a class="breadcrumbs__link" itemprop="item" href="/"><span itemprop="name">Главная</span></a><meta itemprop="position" content="1"></li>
    {% for it in items %}
    <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a class="breadcrumbs__link" itemprop="item" href="{{ it.url }}"><span itemprop="name">{{ it.title }}</span></a><meta itemprop="position" content="{{ loop.index + 1 }}"></li>
    {% endfor %}
    <li class="breadcrumbs__item active"><a class="breadcrumbs__link" href="{{ currentUrl or '#' }}" aria-current="page"><span>{{ current }}</span></a></li>
  </ul>
</nav>
{% endmacro %}

{% macro navigations(prefix, label) %}
<div class="navigations {{ prefix }}__navigations">
  <div class="navigations__inner">
    <button class="navigations__btn navigations__btn--prev {{ prefix }}__button {{ prefix }}__button--prev" type="button" aria-label="Назад: {{ label }}">{{ icon("arrow-left", 16, 16) }}</button>
    <button class="navigations__btn navigations__btn--next {{ prefix }}__button {{ prefix }}__button--next" type="button" aria-label="Вперёд: {{ label }}">{{ icon("arrow-left", 16, 16) }}</button>
  </div>
  <p class="navigations__text" aria-hidden="true">Используйте клавиатуру</p>
</div>
{% endmacro %}

{% macro productCard(p, headingLevel=3, slide=true) %}
<div class="card-product{% if slide %} swiper-slide{% endif %}" data-vendor="{{ p.vendor }}">
  <a class="card-product__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ p.thumb }}" alt="" width="400" height="300" loading="lazy">
    {% if p.maxConfig %}<span class="card-product__equipment"><span>Максимальная</span> комплектация</span>{% endif %}
  </a>
  <div class="card-product__content">
    <h{{ headingLevel }} class="card-product__title"><a href="{{ p.url }}">{{ p.title }}</a></h{{ headingLevel }}>
    <p class="card-product__availability{% if p.availability != 'in_stock' %} card-product__availability--yellow{% endif %}">{{ "В наличии" if p.availability == "in_stock" else "Под заказ" }}</p>
    <ul class="card-product__specifications">
      {% for s in p.cardSpecs %}<li class="card-product__specification">{{ s.name }} <span>{{ s.value }}</span></li>{% endfor %}
      {% if v2 and not p.cardSpecs.length %}<li class="card-product__specification card-product__specification--empty">Характеристики — по запросу</li>{% endif %}
    </ul>
    <button class="card-product__link modal-btn" type="button" data-lead="price" data-product-id="{{ p.slug }}" data-product-title="{{ p.title }}" aria-label="Узнать стоимость: {{ p.title }}" aria-haspopup="dialog">
      Узнать стоимость {{ arrow() }}
    </button>
  </div>
</div>
{% endmacro %}

{% macro catalogSlide(root) %}
<div class="catalog-slide swiper-slide">
  <a class="catalog-slide__link" href="{{ root.url }}">{{ root.title }} {{ arrow() }}</a>
  <div class="catalog-slide__categories">
    {% for ch in root.children %}<a class="catalog-slide__category" href="{{ ch.url }}">{{ ch.title }}</a>{% endfor %}
  </div>
  <img class="catalog-slide__img" src="{{ root.image }}" alt="" width="460" height="560" loading="lazy">
</div>
{% endmacro %}

{% macro leasingLink(text, attrs="", href="") %}
{% if href %}<a class="leasing-link" href="{{ href }}">{% else %}<button class="leasing-link" type="button" {{ attrs | safe }}>{% endif %}
  <span>{{ icon("arrow-right") }}</span>{{ text }}
{% if href %}</a>{% else %}</button>{% endif %}
{% endmacro %}

{% macro emptyState(title, text, cta="Подобрать технику") %}
<div class="empty-state">
  <p class="empty-state__title">{{ title }}</p>
  <p class="empty-state__text">{{ text }}</p>
  <button class="product-button" type="button" data-lead="consultation" aria-haspopup="dialog">{{ cta }} <span>{{ icon("arrow-right") }}</span></button>
</div>
{% endmacro %}

{# Шапка внутренних страниц услуг: .service-header оригинала #}
{% macro serviceHeader(title, text, crumbs, cta="", ctaLead="consultation") %}
<header class="service-header block block--indent">
  {{ breadcrumbs(crumbs, title) }}
  <h1 class="section__title section__title--white section__title--indent-secondary">{{ title }}</h1>
  {% if text %}<p class="service-header__text">{{ text }}</p>{% endif %}
  {% if cta %}<button class="leasing-link service-header__btn modal-btn" type="button" data-lead="{{ ctaLead }}" aria-haspopup="dialog"><span>{{ icon("arrow-right") }}</span>{{ cta }}</button>{% endif %}
</header>
{% endmacro %}
