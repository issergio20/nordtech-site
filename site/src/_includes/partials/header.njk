{# Шапка — разметка оригинала nordtech.su. Главная: прозрачная, при прокрутке header--move. Остальные: header--second #}
{% set S = "/assets/template/img/sprites/sprite.svg" %}
<header class="header{% if not isHome %} header--second{% endif %}" data-header{% if isHome %} data-header-home{% endif %}>
  <div class="header-container">
    <a class="header__logo" href="/" aria-label="{{ site.name }} — на главную">
      <svg width="121" height="42" aria-hidden="true"><use href="{{ S }}#logo"></use></svg>
    </a>
    <a class="header__button" href="{{ '#catalog' if (isHome and not v2) else '/katalog/' }}">
      <span><svg width="22" height="22" aria-hidden="true"><use href="{{ S }}#grip"></use></svg>Каталог</span>
    </a>
    <nav class="header-nav" aria-label="Основное меню">
      <ul class="header-nav__list">
        <li class="header-nav__item header-dropdown">
          <a class="header-nav__link header-dropdown__link" href="/o-kompanii/"{% if page.url.startsWith("/o-kompanii") %} aria-current="page"{% endif %}>О компании</a>
        </li>
        <li class="header-nav__item header-dropdown">
          <a class="header-nav__link header-dropdown__link" href="/uslug/"{% if page.url.startsWith("/uslug") %} aria-current="page"{% endif %}>Услуги
            <svg width="16" height="16" aria-hidden="true"><use href="{{ S }}#chevron-down"></use></svg>
          </a>
          <div class="header-dropdown__list">
            <a class="header-dropdown__item-link" href="/uslug/servisnye-uslugi/">Сервисные услуги</a>
            <a class="header-dropdown__item-link" href="/uslug/servisnye-uslugi/lizing/">Лизинг</a>
            <a class="header-dropdown__item-link" href="/logistika/">Логистика</a>
          </div>
        </li>
        <li class="header-nav__item header-dropdown">
          <a class="header-nav__link header-dropdown__link" href="/kontakty/"{% if page.url.startsWith("/kontakty") %} aria-current="page"{% endif %}>Контакты</a>
        </li>
      </ul>
    </nav>
    <div class="header__right">
      <div class="header-search">
        <button class="header-search__button btn-search" type="button" aria-label="Открыть поиск" aria-controls="site-search" aria-expanded="false" data-search-open>
          <svg width="22" height="22" aria-hidden="true"><use href="{{ S }}#search"></use></svg>
        </button>
      </div>
      <a class="header__phone" href="{{ site.phoneHref }}" aria-label="Позвонить {{ site.phone }}">
        <span><svg width="22" height="22" aria-hidden="true"><use href="{{ S }}#smartphone"></use></svg>{{ site.phone }}</span>
      </a>
      <div class="header__socials">
        <a class="header__social-link" href="https://ok.ru/group/70000036933413" target="_blank" rel="noopener" aria-label="Одноклассники"><svg width="36" height="36" aria-hidden="true"><use href="{{ S }}#classmates"></use></svg></a>
        <a class="header__social-link" href="https://vk.com/nordtechgroup" target="_blank" rel="noopener" aria-label="ВКонтакте"><svg width="36" height="36" aria-hidden="true"><use href="{{ S }}#vk"></use></svg></a>
        <a class="header__social-link" href="https://t.me/nordtechgroup" target="_blank" rel="noopener" aria-label="Telegram"><svg width="36" height="36" aria-hidden="true"><use href="{{ S }}#tg"></use></svg></a>
        <button class="hamburger show-menu" type="button" aria-label="Меню" aria-controls="site-menu" aria-expanded="false" data-menu-toggle><span></span></button>
      </div>
    </div>
  </div>
</header>
