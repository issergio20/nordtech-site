{% set S = "/assets/template/img/sprites/sprite.svg" %}
<footer class="footer" id="footer">
  <div class="footer__cooperating">
    <p class="footer__text">© 2003—{{ "" | year }} NORD, все авторские права защищены.</p>
    <a class="footer__cooperating-link" href="/politika-konfidencialnosti/">Политика конфиденциальности</a>
  </div>
  <div class="footer__contacts">
    <a class="footer__text footer-link" href="{{ site.phoneHref }}">{{ site.phone }}</a>
    <div class="footer__contacts-links">
      <a class="footer__contacts-link" href="https://ok.ru/group/70000036933413" target="_blank" rel="noopener noreferrer" aria-label="Одноклассники"><svg width="147" height="32" aria-hidden="true"><use href="{{ S }}#classmates"></use></svg></a>
      <a class="footer__contacts-link" href="https://vk.com/nordtechgroup" target="_blank" rel="noopener noreferrer" aria-label="ВКонтакте"><svg width="147" height="32" aria-hidden="true"><use href="{{ S }}#vk"></use></svg></a>
      <a class="footer__contacts-link" href="https://t.me/nordtechgroup" target="_blank" rel="noopener noreferrer" aria-label="Telegram"><svg width="147" height="32" aria-hidden="true"><use href="{{ S }}#tg"></use></svg></a>
    </div>
  </div>
  {% if v2 %}
  <nav class="footer__nav" aria-label="Разделы сайта">
    <a href="/katalog/">Каталог</a><a href="/uslug/">Услуги</a><a href="/uslug/servisnye-uslugi/lizing/">Лизинг</a><a href="/logistika/">Логистика</a><a href="/o-kompanii/">О компании</a><a href="/kontakty/">Контакты</a>
  </nav>
  {% endif %}
  <a class="footer__developer footer__text footer-link" href="https://vostokweb.ru/" target="_blank" rel="noopener">Разработка сайта
    <svg width="147" height="32" aria-hidden="true"><use href="{{ S }}#developer"></use></svg>
  </a>
</footer>
