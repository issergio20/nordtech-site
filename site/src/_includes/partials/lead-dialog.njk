{# Окно заявки в стиле оригинала (.modal.modal--right.modal-feedback, поля .ui-input, .ui-checkbox, .button--blue),
   но на нативном <dialog>: фокус внутри, Esc, возврат фокуса. Тип заявки задаёт кнопка: data-lead="price|consultation|leasing|question" #}
{% set S = "/assets/template/img/sprites/sprite.svg" %}
<dialog class="lead-dialog" id="lead-dialog" aria-labelledby="lead-title">
  <div class="modal modal--right modal-feedback">
    <button class="modal__close" type="button" aria-label="Закрыть" data-dialog-close>
      <svg width="32" height="32" aria-hidden="true"><use href="{{ S }}#cross"></use></svg>
    </button>
    <div class="modal__inner" data-lead-body>
      <h2 class="modal__title modal-feedback__title" id="lead-title" data-lead-title>Оформить заявку</h2>
      <p class="modal__text modal-feedback__text" data-lead-sub>Наш специалист свяжется с вами в ближайшее время</p>
      <form class="modal-feedback__form" novalidate data-lead-form>
        <input type="hidden" name="type" value="price">
        <input type="hidden" name="product_id" value="">
        <input type="hidden" name="submit_token" value="">
        <input type="hidden" name="page_url" value="">
        <div class="hp" aria-hidden="true"><label>Не заполняйте <input name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="modal-feedback__form-inputs">
          <div class="ui-input modal-feedback__form-input">
            <input class="ui-input__input" type="text" name="name" id="lead-name" autocomplete="name" required maxlength="128" aria-describedby="lead-name-err">
            <label class="ui-input__label" for="lead-name">Имя</label>
            <p class="field__error" id="lead-name-err" hidden></p>
          </div>
          <div class="ui-input modal-feedback__form-input">
            <input class="ui-input__input" type="tel" name="phone" id="lead-phone" inputmode="tel" autocomplete="tel" required aria-describedby="lead-phone-err">
            <label class="ui-input__label" for="lead-phone">Телефон</label>
            <p class="field__error" id="lead-phone-err" hidden></p>
          </div>
          <div class="ui-input modal-feedback__form-input" data-field="email">
            <input class="ui-input__input" type="email" name="email" id="lead-email" autocomplete="email">
            <label class="ui-input__label" for="lead-email">Email</label>
          </div>
          <div class="ui-input ui-input--textarea modal-feedback__form-input" data-field="product">
            <textarea class="ui-input__input" name="product_title" id="lead-product" readonly rows="2"></textarea>
            <label class="ui-input__label" for="lead-product">Название товара</label>
          </div>
          <div class="ui-input ui-input--active modal-feedback__form-input" data-field="city">
            <select class="ui-input__input" name="city" id="lead-city">
              <option value="">Не важно</option>
              {% for b in branches %}{% if b.kind == "branch" %}<option value="{{ b.code }}">{{ b.city }}</option>{% endif %}{% endfor %}
            </select>
            <label class="ui-input__label" for="lead-city">Ближайший филиал</label>
          </div>
          <div class="ui-input ui-input--textarea modal-feedback__form-input" data-field="comment">
            <textarea class="ui-input__input" name="comment" id="lead-comment" maxlength="2000"></textarea>
            <label class="ui-input__label" for="lead-comment">Комментарий</label>
          </div>
        </div>
        <div class="modal-feedback__form-bottom">
          <div class="ui-checkbox">
            <input class="ui-checkbox__input" type="checkbox" name="consent" value="1" id="lead-consent" required aria-describedby="lead-consent-err">
            <label class="ui-checkbox__label" for="lead-consent">Нажимая кнопку «Отправить», я соглашаюсь с <a href="/obrabotka-dannyh/" target="_blank">условиями обработки персональных данных*</a></label>
            <p class="field__error" id="lead-consent-err" hidden></p>
          </div>
          <button class="button button--blue modal-feedback__form-btn" type="submit"><span data-submit-label>Оставить заявку</span></button>
        </div>
      </form>
    </div>
    <div class="modal__inner modal-success__inner lead-done" data-lead-done hidden tabindex="-1">
      <img src="/assets/template/img/svg/success.svg" alt="" width="82" height="82">
      <h2 class="modal__title modal-feedback__title">Заявка принята</h2>
      <p class="modal__text">Наш специалист свяжется с вами в ближайшее время</p>
      <button class="button button--blue modal-success__btn" type="button" data-dialog-close>Хорошо</button>
    </div>
  </div>
</dialog>
