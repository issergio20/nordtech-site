{% import "ui/ui.njk" as ui with context %}
{# .section-error — блок 404 из CSS оригинала #}
<section class="section-error section">
  <div class="container">
    <h1 class="section__title">Страница не найдена</h1>
    <p class="section-error__text">Возможно, модель переехала в другой раздел. Посмотрите каталог или найдите её поиском.</p>
    <div class="product__buttons">
      <a class="product-button" href="/katalog/">Каталог <span>{{ ui.icon("arrow-right") }}</span></a>
      <a class="product-button product-button--accent" href="/rezultaty-poiska/">Поиск <span>{{ ui.icon("search") }}</span></a>
    </div>
  </div>
</section>
