---
layout: layouts/base.njk
pagination:
  data: catalog.flat
  size: 1
  alias: c
permalink: "{{ c.url }}"
eleventyComputed:
  title: "{{ c.title | cap }}"
  description: "{{ c.title | cap }} от официального дилера НОРД: наличие, характеристики, цены по запросу, лизинг и доставка."
---
{% import "ui/ui.njk" as ui with context %}
{# S03 / S04 — раздел и подраздел в разметке оригинала (.categories). Вместо сломанного фильтра (печатал Array) — фильтр по бренду #}
{% set crumbs = [{title: "Каталог", url: "/katalog/"}] %}
{% if c.parent %}{% set crumbs = [{title: "Каталог", url: "/katalog/"}, c.parent] %}{% endif %}
<section class="categories section section--indent" data-catalog data-page-size="4">
  <div class="container">
    <header class="categories-header">
      {{ ui.breadcrumbs(crumbs, c.title | cap, c.url) }}
      <h1 class="section__title section__title--white section__title--indent-secondary">{{ c.title | cap }}</h1>
      <div class="categories-header__inner">
        {% if c.tabs.length %}
        <nav class="categories-header__links" aria-label="Подразделы">
          {% for t in c.tabs %}{% if t.count or not site.hideEmptyCategories %}
          <a class="categories-header__link{% if t.current %} active{% endif %}" href="{{ t.url }}"{% if t.current %} aria-current="page"{% endif %}>{{ t.title | cap }}{{ ui.icon("arrow-up-right", 22, 22) }}</a>
          {% endif %}{% endfor %}
        </nav>
        {% endif %}
        {% if c.vendors.length > 1 %}
        <fieldset class="brand-filter" data-filter="vendor">
          <legend>Бренд</legend>
          {% for v in c.vendors %}<label class="brand-filter__item"><input type="checkbox" name="vendor" value="{{ v }}"><span>{{ v }}</span></label>{% endfor %}
        </fieldset>
        {% endif %}
      </div>
      <p class="catalog-count" aria-live="polite" data-count data-total="{{ c.count }}">{{ c.count | plural("модель", "модели", "моделей") }}</p>
    </header>
    {% if c.count %}
    <div class="categories__list" data-cards>
      {% for p in c.products %}{{ ui.productCard(p, 2, false) }}{% endfor %}
    </div>
    <div class="double_pagination catalog-page__paginations">
      <button class="pagination__more" type="button" data-more hidden><span data-more-label>Показать еще</span>{{ ui.icon("refresh-cw") }}</button>
      <nav aria-label="Страницы" data-pages-nav hidden><ul class="pagination" data-pages></ul></nav>
    </div>
    {% else %}
    {{ ui.emptyState("Скоро здесь появится техника", "Раздел пополняется. Расскажите, что нужно, — подберём модель у производителя и привезём под заказ.") }}
    {% endif %}
  </div>
</section>
