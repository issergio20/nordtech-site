---
layout: layouts/base.njk
pagination:
  data: catalog.products
  size: 1
  alias: p
permalink: "{{ p.url }}"
eleventyComputed:
  title: "{{ p.title }}"
  description: "{{ p.title }} — {{ 'в наличии' if p.availability == 'in_stock' else 'под заказ' }} у официального дилера НОРД. Узнайте цену с доставкой, условия лизинга и гарантии."
---
{% import "ui/ui.njk" as ui %}
{# S05 — карточка товара в разметке оригинала (.product). Галерея — Swiper + Fancybox, как на сайте #}
<section class="product section section--indent" itemscope itemtype="https://schema.org/Product">
  <div class="container">
    {{ ui.breadcrumbs(p.trail | capitalizeTitles, p.title, p.url) }}
    <h1 class="section__title section__title--indent-secondary product__title" itemprop="name">{{ p.title }}</h1>
    <meta itemprop="brand" content="{{ p.vendor }}">
    <div class="product__row">
      <div class="product__sliders" data-gallery>
        <div class="product-slider__main swiper">
          <div class="swiper-wrapper">
            {% for ph in p.photos %}
            <div class="swiper-slide"><a href="{{ ph.full }}" data-fancybox="gallery" aria-label="Открыть фото {{ loop.index }} из {{ p.photos.length }}"><img src="{{ ph.big }}" alt="{{ p.title }}, фото {{ loop.index }}" width="800" height="600"{% if not loop.first %} loading="lazy"{% endif %}></a></div>
            {% endfor %}
          </div>
        </div>
        {% if p.photos.length > 1 %}
        <div class="product-slider__thumb swiper">
          <div class="swiper-wrapper">
            {% for ph in p.photos %}<div class="swiper-slide"><img src="{{ ph.small }}" alt="" width="160" height="120" loading="lazy"></div>{% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
      <div class="product__content">
        <div class="product__block">
          <p class="product__availability{% if p.availability != 'in_stock' %} product__availability--yellow{% endif %}">{{ "В наличии" if p.availability == "in_stock" else "Под заказ" }}</p>
          {% if p.description %}<div class="product__description" itemprop="description"><p>{{ p.description }}</p></div>{% endif %}
        </div>
        <div class="product__buttons">
          <button class="product-button modal-btn" type="button" data-lead="price" data-product-id="{{ p.slug }}" data-product-title="{{ p.title }}" aria-haspopup="dialog">Узнать стоимость <span>{{ ui.icon("arrow-right") }}</span></button>
          <button class="product-button product-button--accent" type="button" data-lead="question" data-product-id="{{ p.slug }}" data-product-title="{{ p.title }}" aria-haspopup="dialog">Задать вопрос <span>{{ ui.icon("tg") }}</span></button>
        </div>
        {% if p.specs.length %}
        <ul class="product__specifications">
          {% for s in p.specs %}<li class="product__specification">{{ s.name }} <span>{{ s.value }}</span></li>{% endfor %}
        </ul>
        {% else %}
        <div class="product__no-specs">
          <p>Полные характеристики этой модели пришлём по запросу — с комплектацией, которая есть на складе сейчас.</p>
          <button class="leasing-link" type="button" data-lead="question" data-product-id="{{ p.slug }}" data-product-title="{{ p.title }}" aria-haspopup="dialog"><span>{{ ui.icon("arrow-right") }}</span>Запросить характеристики</button>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
