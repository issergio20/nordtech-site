{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-primitives",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "replica/design"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "site-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev:v2"
      ],
      "port": 8081
    }
  ]
}